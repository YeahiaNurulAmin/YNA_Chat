VITE_CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# LiveKit WebSocket URL (same project as backend LIVEKIT_URL)
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Note: this app talks to the backend on http://localhost:3000 and the browser picks up
# proxy settings from the operating system, so no proxy configuration is needed here.
# Just make sure loopback traffic bypasses the proxy (backend NO_PROXY, and the Windows
# ProxyOverride / "<local>" bypass list) or the SPA will not be able to reach the API.
