PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/yna_chat

# Outbound proxy — only needed on restricted networks where direct egress is blocked.
# When set, it is used for:
#   * fetch-based services: Clerk, ImageKit, LiveKit, Nominatim, cron health ping
#   * MongoDB: an HTTP(S) proxy is tunnelled through a local SOCKS5 bridge,
#     a socks5:// proxy is handed straight to the MongoDB driver.
# Leave everything below empty/commented for direct connections.
# PROXY_URL=http://127.0.0.1:8080
# NO_PROXY=localhost,127.0.0.1,::1
# Local loopback port for the SOCKS5 bridge (default 10808).
# MONGODB_PROXY_PORT=10808
# Override the DNS-over-HTTPS resolver used to expand mongodb+srv:// on networks
# where the system resolver cannot answer SRV queries.
# MONGODB_DOH_URL=https://dns.google/resolve
# Set to 1 to force the native SRV lookup instead of DoH.
# MONGODB_SKIP_DOH=0
# Optional comma-separated DNS servers to force for SRV lookups.
# MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4

# Clerk
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Optional: override keep-alive ping URL (Render sets RENDER_EXTERNAL_URL automatically)
# APP_URL=https://your-app.onrender.com

# LiveKit (voice/video calls — use LiveKit Cloud for MVP)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
